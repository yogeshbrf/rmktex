# ==============================================================================
# RMK TEXTILES / E-COMMERCE ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and configure your values.
# ==============================================================================

# Application Environment (production | development)
NODE_ENV=production

# Server Port (used for local development)
PORT=5000

# JSON Web Token Secret Key
JWT_SECRET=rmk-textiles-jwt-secret-key-2026-production

# Backend Base URL:
# - Leave blank on Vercel to automatically route to internal /api
# - Or enter your deployed backend URL: e.g. https://rmktex-backend.onrender.com
BACKEND_URL=
NEXT_PUBLIC_API_URL=
VITE_BACKEND_URL=

# Socket.IO Server URL (optional, for persistent live WebSocket order sync)
SOCKET_URL=
