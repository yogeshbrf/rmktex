{
  "name": "e-commerce-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace for E-commerce-main + E-commerce-dashboard + Central Backend",
  "scripts": {
    "build": "node build.js",
    "setup": "cd server && npm install && cd ../E-commerce-main && npm install",
    "seed": "cd server && node seed.js",
    "start:backend": "cd server && node index.js",
    "start:proxy": "cd E-commerce-main && node server.js",
    "start:frontend": "cd E-commerce-main && npx vite preview --port 5173",
    "start": "cd E-commerce-main && npm run dev",
    "dev": "cd E-commerce-main && npm run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.11.0",
    "uuid": "^10.0.0"
  }
}
