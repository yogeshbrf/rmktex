{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/products(.*)",
      "destination": "/api/products.json"
    },
    {
      "source": "/api/categories(.*)",
      "destination": "/api/categories.json"
    },
    {
      "source": "/api/sellers(.*)",
      "destination": "/api/sellers.json"
    },
    {
      "source": "/api/health(.*)",
      "destination": "/api/health.json"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/$1"
    },
    {
      "source": "/imgs/(.*)",
      "destination": "/imgs/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/data/(.*)",
      "destination": "/data/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
